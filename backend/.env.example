# Backend runtime
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Frontend CORS (comma-separated; never use * in production)
FRONTEND_URLS=https://your-frontend.example.com
FRONTEND_URL=https://your-frontend.example.com

# Python face recognition service
FACE_REC_SERVICE_URL=https://your-face-service.example.com
FACE_API_KEY=
FACE_API_TIMEOUT_MS=15000

# Python recommendation service (backend-to-service only)
RECOMMENDATION_SERVICE_URL=https://your-recommendation-service.example.com
RECOMMENDATION_API_KEY=

# Request/database hardening
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Optional bootstrap control; keep disabled after initial admin creation
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_KEY=
ADMIN_MAX_COUNT=2
