# Mobile app environment (copy to .env.local)

# Required: backend URL reachable from your device/emulator
# Android emulator: http://10.0.2.2:5000
# Physical device:  http://YOUR_LAN_IP:5000  (same Wi‑Fi as PC)
# Production:       https://your-deployed-api.com
EXPO_PUBLIC_API_URL=http://192.168.0.100:5000

# Keep false for real backend testing (mock only on network failure when true)
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=false
